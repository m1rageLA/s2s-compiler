    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.13.14",
        "@vitest/coverage-v8": "^3.1.3",
        "autoprefixer": "^10.4.21",
        "commitizen": "^4.3.1",
        "cz-customizable": "^7.5.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.2",
        "vitest": "^3.1.2"
    },
    "dependencies": {
        "@types/npm": "^7.19.3",
        "express": "^5.2.1",
        "js-yaml": "^4.1.0",
        "ts-node": "^10.9.2"
    },
    "config": {
        "commitizen": {
